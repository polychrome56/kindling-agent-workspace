# 复制本文件为 config/git-publish.env，并填写本机使用的发布配置。
# 不要提交 config/git-publish.env，也不要把真实 token 写进任何会被提交的文件。

GITHUB_OWNER=your-github-user-or-org
GITHUB_REPO=kindling-agent-workspace
GITHUB_VISIBILITY=private

# 可选。用于本次提交身份；留空时使用当前仓库或系统 git config。
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# 可选。仅写入本地 config/git-publish.env；gh 与 git over HTTPS 可读取 GH_TOKEN。
GH_TOKEN=

# 可选。留空时使用默认 remote 名称。
GIT_REMOTE_NAME=origin
